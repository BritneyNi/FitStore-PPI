# ============================================================
#  FitStore — variables de entorno para desarrollo local
#
#  Copia este archivo como `.env` (ignorado por Git) y completa
#  los valores. No escribas credenciales reales aqui.
#
#  PowerShell:  $env:DB_PASSWORD = "tu_clave"
#  Bash:        export DB_PASSWORD="tu_clave"
# ============================================================

# --- Backend (Spring Boot) ---
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contrasena
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Origenes permitidos por CORS (Vite en desarrollo y preview)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080/api
